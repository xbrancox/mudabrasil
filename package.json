{
  "name": "votabrasil-backend",
  "version": "1.0.0",
  "description": "VotaBrasil — Backend de revogação do voto",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node tests/smoke.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "playwright test tests/e2e/",
    "test:all": "npm test && npm run test:unit",
    "test:security": "echo '⚠️ Security scan — run: docker run --rm -t owasp/zap2docker-stable zap-baseline.py -t http://localhost:8080'",
    "health:check": "node scripts/health_check.js",
    "test:photos": "node scripts/validar-fotos.js",
    "test:photos:strict": "node scripts/validar-fotos.js --strict",
    "backup:photos": "node scripts/backup-fotos.js",
    "backup:photos:dry": "node scripts/backup-fotos.js --dry-run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "nodemailer": "^9.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "keywords": [
    "civic",
    "transparency",
    "brazil"
  ],
  "author": "VotaBrasil",
  "license": "MIT"
}
