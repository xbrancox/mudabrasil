@echo off
setlocal
title VotaBrasil - Notificacoes PWA (v7) + LOG
cd /d "%~dp0"
set "LOG=%~dp0LOG-NOTIFICACOES.txt"
echo Log: %LOG%
call :MAIN > "%LOG%" 2>&1
type "%LOG%"
echo.
pause
exit /b 0

:MAIN
echo [1/4] Gravando MudaBrasil\notificacoes-pwa.js (base64, imune a encoding)...
powershell -NoProfile -Command "[IO.File]::WriteAllText('MudaBrasil/notificacoes-pwa.js',[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('')))"
if exist "MudaBrasil\notificacoes-pwa.js" (echo   [OK] gravado) else (echo   [FALHOU] nao gravado & exit /b 1)
echo [2/4] Inserindo tag script no MudaBrasil\index.html...
powershell -NoProfile -Command "$p='MudaBrasil/index.html';$c=[IO.File]::ReadAllText($p);if($c.Contains('notificacoes-pwa.js')){'JA-PATCHED'}else{$b=[char]60+'/body'+[char]62;$t='  '+[char]60+'script src='+[char]34+'notificacoes-pwa.js'+[char]34+' defer'+[char]62+[char]60+'/script'+[char]62;$c=$c.Replace($b,$t+[char]10+$b);[IO.File]::WriteAllText($p,$c);'PATCH-OK'}"
echo [3/4] Commit e push...
git add -A
git commit -m "feat: notificacoes PWA 50/70 v7"
git push origin main
echo [4/4] Concluido. Confira em ~2 min: https://xbrancox.github.io/mudabrasilv4/
exit /b 0
